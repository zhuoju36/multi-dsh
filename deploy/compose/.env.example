# Platform stack environment (copy to deploy/compose/secrets/platform.env, chmod 600).
POSTGRES_PASSWORD=replace-with-a-long-random-password  # 只用 URL 安全字符（A-Za-z0-9_-），它会拼进 DATABASE_URL
POSTGRES_DATA_DIR=/srv/multi-dsh/pgdata
POSTGRES_PORT=5432
AUTH_PUBLIC_URL=http://127.0.0.1:18000
PUBLIC_ORIGIN=http://127.0.0.1:18000
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# Upstream Messages-compatible endpoint; keep the /anthropic prefix.
UPSTREAM_BASE_URL=https://api.deepseek.com/anthropic
PLATFORM_API_KEY=sk-replace-with-the-platform-key
# 0 disables the monthly token quota (per-user aggregation is still recorded).
MONTHLY_QUOTA_TOKENS=0

# MinIO (restic backup target, loopback only)
MINIO_ROOT_USER=multi-dsh
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password  # URL 安全字符
MINIO_DATA_DIR=/srv/multi-dsh/minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Hub control plane (host service); auth reaches it over /srv/multi-dsh/run/hub.sock
HUB_TOKEN=replace-with-a-long-random-token
HUB_RUN_DIR=/srv/multi-dsh/run
# Hub / tenant defaults (read by services/hub and the auth admin CLI)
DSH_IMAGE=multi-dsh/dsh:0.2.2-rc.2
DSH_VERSION=0.2.2-rc.2
TENANT_CPUS=2
TENANT_MEMORY=1536m
IDLE_TIMEOUT_MS=0
