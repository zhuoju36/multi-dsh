# 依赖与产物
node_modules/
dist/
build/
.pnpm-store/

# 本地环境
.env
.env.*
!.env.example
*.local

# 凭据与数据
.credentials.yaml
/data/
*.pem
*.key

# 本地记忆库（meow-memory，含机器本地数据，不入库）
.dsh-meow/

# 本地决策记录（ADR，仅本机保存，不入库）
docs/adr/

# 日志与临时文件
*.log
tmp/
.cache/

# 编辑器/系统
.DS_Store
.idea/
.vscode/
*.swp

# 租户环境文件与密钥（运行时生成）
deploy/compose/tenants/*.env
deploy/compose/secrets/*
!deploy/compose/tenants/.gitkeep
!deploy/compose/secrets/.gitkeep

# 测试临时目录
.tmp-*
